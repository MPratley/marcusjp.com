---
const siteTitle =
  "Marcus Pratley | Software Engineer, Photographer & Singer in London";
const siteDescription =
  "London-based software engineer building web applications, film photographer specializing in headshots and choir photography, and choir singer.";
const siteUrl = "https://marcusjp.com";
const socialImage = `${siteUrl}/tactical.jpg`;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Basic Meta Tags -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <meta name="author" content="Marcus Pratley" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:image" content={socialImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={siteUrl} />
    <meta property="twitter:title" content={siteTitle} />
    <meta property="twitter:description" content={siteDescription} />
    <meta property="twitter:image" content={socialImage} />

    <!-- Additional SEO -->
    <link rel="canonical" href={siteUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <main class="hero">
      <div class="hero-image"></div>
      <div class="overlay-card">
        <h1>Marcus Pratley</h1>
        <nav>
          <a href="#software" data-section="software">software</a>
          <span class="separator">|</span>
          <a href="#photography" data-section="photography">photography</a>
          <span class="separator">|</span>
          <a href="#singing" data-section="singing">singing</a>
          <span class="separator">|</span>
          <a href="#contact" data-section="contact">contact</a>
        </nav>

        <!-- Content sections inside the same card -->
        <div class="content-area">
          <section
            id="software"
            class="content-section"
            data-content="software"
          >
            <h2>Software</h2>
            <p>
              I build things for the web, mostly. <br /><br />
              Active projects:
              <ul>
                <li>
                  <a href="https://pointsofview.london">pointsofview.london</a> -
                  a website to match your letterboxd watchlist with cinema showtimes
                  in London
                </li>
                <li>
                  <a href="https://symbel.marcusjp.com">symbel.marcusjp.com</a> -
                  a calendar app website / extension for the Symbel Choir.
                </li>
              </ul>
              Past projects can be found on my github. My CV is available on my LinkedIn.
            </p>
            <br /><br />
            <div class="links">
              <a
                href="https://github.com/mpratley"
                target="_blank"
                rel="noopener noreferrer">GitHub</a
              >
              <a
                href="https://linkedin.com/in/MPratley"
                target="_blank"
                rel="noopener noreferrer">LinkedIn</a
              >
            </div>
          </section>

          <section
            id="photography"
            class="content-section"
            data-content="photography"
          >
            <h2>Photography</h2>
            <p>
              I do a fair amount of film photography, and sometimes develop it
              myself too. I do a few headshots and photoshoots for choirs and
              other groups - get in touch if you'd like to work together.
            </p>
            <p>-- photo portfolio WIP --</p>
            <div class="links">
              <a
                href="https://instagram.com/jpmarcusco"
                target="_blank"
                rel="noopener noreferrer">Instagram</a
              >
            </div>
          </section>

          <section id="singing" class="content-section" data-content="singing">
            <h2>Singing</h2>
            <p>
              Currently singing at St Gabriel's Pimlico on Sunday mornings, and
              with the Symbel Choir most weeks for the odd service here and
              there.
            </p>
            <div class="links">
              <a
                href="https://symbelchoir.co.uk/"
                target="_blank"
                rel="noopener noreferrer">Symbel Choir</a
              >
            </div>
          </section>

          <section id="contact" class="content-section" data-content="contact">
            <h2>Contact</h2>
            <p>
              Get in touch! I'm always happy to chat about projects, thoughts,
              or just to say hi if we've met before. I'm available on email and
              instagram.
            </p>
            <div class="links">
              <a
                href="#"
                class="email-link"
                data-user="hi"
                data-domain="marcusjp.com"
              >
                hi[at]marcusjp[dot]com
              </a>
              <a
                href="https://instagram.com/jpmarcusco"
                target="_blank"
                rel="noopener noreferrer">Instagram</a
              >
            </div>
          </section>
        </div>

        <!-- Noscript fallback for SEO -->
        <noscript>
          <div class="noscript-content">
            <section>
              <h2>Software</h2>
              <p>
                I build things for the web, mostly. <br /><br />
                Active projects:
              </p>
              <ul>
                <li>
                  <a href="https://pointsofview.london">pointsofview.london</a> -
                  a website to match your letterboxd watchlist with cinema showtimes
                  in London
                </li>
                <li>
                  <a href="https://symbel.marcusjp.com">symbel.marcusjp.com</a> -
                  a calendar app website / extension for the Symbel Choir.
                </li>
              </ul>
              <p>
                Past projects can be found on my github. My CV is available on
                my LinkedIn.
              </p>
              <p>
                <a
                  href="https://github.com/mpratley"
                  target="_blank"
                  rel="noopener noreferrer">GitHub</a
                > |
                <a
                  href="https://linkedin.com/in/MPratley"
                  target="_blank"
                  rel="noopener noreferrer">LinkedIn</a
                >
              </p>
            </section>

            <section>
              <h2>Photography</h2>
              <p>
                I do a fair amount of film photography, and sometimes develop it
                myself too. I do a few headshots and photoshoots for choirs and
                other groups - get in touch if you'd like to work together.
              </p>
              <p>-- photo portfolio WIP --</p>
              <p>
                <a
                  href="https://instagram.com/jpmarcusco"
                  target="_blank"
                  rel="noopener noreferrer">Instagram</a
                >
              </p>
            </section>

            <section>
              <h2>Singing</h2>
              <p>
                Currently singing at St Gabriel's Pimlico on Sunday mornings,
                and with the Symbel Choir most weeks for the odd service here
                and there.
              </p>
              <p>
                <a
                  href="https://symbelchoir.co.uk/"
                  target="_blank"
                  rel="noopener noreferrer">Symbel Choir</a
                >
              </p>
            </section>

            <section>
              <h2>Contact</h2>
              <p>
                Get in touch! I'm always happy to chat about projects, thoughts,
                or just to say hi if we've met before. I'm available on email
                and instagram.
              </p>
              <p>
                Email: hi@marcusjp.com |
                <a
                  href="https://instagram.com/jpmarcusco"
                  target="_blank"
                  rel="noopener noreferrer">Instagram</a
                >
              </p>
            </section>
          </div>
        </noscript>
      </div>
    </main>

    <script>
      // Handle navigation clicks
      document.querySelectorAll("nav a").forEach((link) => {
        link.addEventListener("click", (e) => {
          e.preventDefault();
          const section = link.getAttribute("data-section");
          const contentSection = document.querySelector(
            `[data-content="${section}"]`
          );
          const contentArea = document.querySelector(".content-area");

          // If clicking the same active section, close it
          if (contentSection && contentSection.classList.contains("active")) {
            contentSection.classList.remove("active");
            if (contentArea) {
              contentArea.classList.remove("active");
            }
            document.body.classList.remove("content-active");
            return;
          }

          // Close all other content sections
          document.querySelectorAll(".content-section").forEach((section) => {
            section.classList.remove("active");
          });

          // Show the clicked content section
          if (contentSection) {
            contentSection.classList.add("active");
          }
          if (contentArea) {
            contentArea.classList.add("active");
          }
          document.body.classList.add("content-active");
        });
      });

      // Handle email link clicks
      document.querySelectorAll(".email-link").forEach((link) => {
        link.addEventListener("click", (e) => {
          e.preventDefault();
          const user = link.getAttribute("data-user");
          const domain = link.getAttribute("data-domain");
          if (user && domain) {
            window.location.href = `mailto:${user}@${domain}`;
          }
        });
      });

      // Close content when clicking outside
      document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (!target.closest(".overlay-card")) {
          document.querySelectorAll(".content-section").forEach((section) => {
            section.classList.remove("active");
          });
          const contentArea = document.querySelector(".content-area");
          if (contentArea) {
            contentArea.classList.remove("active");
          }
          document.body.classList.remove("content-active");
        }
      });

      // Handle escape key to close content
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          document.querySelectorAll(".content-section").forEach((section) => {
            section.classList.remove("active");
          });
          const contentArea = document.querySelector(".content-area");
          if (contentArea) {
            contentArea.classList.remove("active");
          }
          document.body.classList.remove("content-active");
        }
      });
    </script>
  </body>
</html>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Roboto",
      "Oxygen", "Ubuntu", "Cantarell", "Fira Sans", "Droid Sans",
      "Helvetica Neue", sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow: hidden;
    background-color: #2d2d2d;
  }

  /* Allow scrolling on mobile when content is active */
  @media (max-width: 768px) {
    body.content-active {
      overflow-y: auto;
    }
  }

  .hero {
    position: relative;
    width: 100vw;
    min-height: 100vh;
    overflow: hidden;
  }

  /* Allow hero to expand on mobile when content is active */
  @media (max-width: 768px) {
    body.content-active .hero {
      height: auto;
      min-height: 100vh;
      overflow: visible;
    }
  }

  .hero-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url("/tactical.jpg");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    z-index: 1;
  }

  .overlay-card {
    position: absolute;
    top: 50%;
    left: 8%;
    background: linear-gradient(135deg, #fffbf2 0%, #fdf8ed 100%);
    padding: 3rem 4rem;
    border-radius: 0px;
    z-index: 2;
    backdrop-filter: blur(5px);
    font-family: "Noto Serif", serif;
  }

  .overlay-card h1 {
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 700;
    color: #2d2d2d;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 1.5rem;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  a {
    color: #2d2d2d;
    text-decoration: none;
  }

  a:hover {
    color: #8b6d47;
    text-decoration: underline;
  }

  nav a {
    font-size: clamp(0.9rem, 2vw, 1.1rem);
    font-weight: 400;
  }

  .separator {
    color: #2d2d2d;
    opacity: 0.4;
    font-weight: 300;
  }

  /* Content area and sections */
  .content-area {
    display: none;
  }

  .content-area.active {
    display: block;
    margin-top: 2rem;
  }

  .content-section {
    display: none;
  }

  .content-section.active {
    display: block;
  }

  .content-section h2 {
    /* Visually hidden but accessible to screen readers and search engines */
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  .content-section p {
    font-size: 1rem;
    line-height: 1.6;
    color: #2d2d2d;
    margin-bottom: 1.5rem;
    opacity: 0.9;
  }

  .content-section ul {
    list-style: none;
    padding-left: 0;
    margin: 1rem 0;
  }

  .content-section li {
    padding-left: 1.5rem;
    position: relative;
    margin-bottom: 0.75rem;
    line-height: 1.6;
  }

  .content-section li::before {
    content: ">";
    position: absolute;
    left: 0;
    color: #2d2d2d;
    font-weight: 700;
  }

  .links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .links a {
    color: #2d2d2d;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500;
  }

  .links a:hover {
    color: #8b6d47;
    text-decoration: underline;
  }

  /* Noscript content styling */
  .noscript-content {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(45, 45, 45, 0.2);
  }

  .noscript-content section {
    margin-bottom: 2rem;
  }

  .noscript-content h2 {
    font-size: 1.5rem;
    font-weight: 600;
    color: #2d2d2d;
    margin-bottom: 1rem;
  }

  .noscript-content p {
    font-size: 1rem;
    line-height: 1.6;
    color: #2d2d2d;
    margin-bottom: 1rem;
    opacity: 0.9;
  }

  .noscript-content ul {
    list-style: none;
    padding-left: 0;
    margin: 1rem 0;
  }

  .noscript-content li {
    padding-left: 1.5rem;
    position: relative;
    margin-bottom: 0.75rem;
    line-height: 1.6;
  }

  .noscript-content li::before {
    content: ">";
    position: absolute;
    left: 0;
    color: #2d2d2d;
    font-weight: 700;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .hero-image {
      background-image: url("/crop.jpg");
    }

    .overlay-card {
      top: 55%;
      left: 50%;
      transform: translateX(-50%);
      padding: 2rem 3rem;
      width: 85%;
      text-align: left;
    }

    nav {
      justify-content: left;
    }
  }

  @media (max-width: 480px) {
    .overlay-card {
      padding: 1.5rem 2rem;
      width: 90%;
    }

    .content-section p {
      font-size: 0.95rem;
    }

    .links {
      gap: 1rem;
    }
  }
</style>
